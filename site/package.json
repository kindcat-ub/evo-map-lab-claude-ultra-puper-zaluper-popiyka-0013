{
	"name": "last-drop-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"sim": "node ../sim/src/cli.ts --seed ${PUBLIC_SIM_SEED:-42} --out static/sim",
		"dev": "npm run sim && vite dev",
		"build": "npm run sim && vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^22.20.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "5.9",
		"vite": "^7.3.7",
		"vitest": "^3.2.7"
	}
}
