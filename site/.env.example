# Where the site reads content from.
#   sim    the shared generator (sim/) in-process → contract projections (default)
#   http   the contract HTTP API at PUBLIC_API_BASE
PUBLIC_CONTENT_SOURCE=sim
# Same seed is used by `npm run sim`, which renders the media files into static/sim
PUBLIC_SIM_SEED=42

# For http: live API (https://host/api/v1), or a static export (contracts cli export) with PUBLIC_API_STATIC=1
PUBLIC_API_BASE=
PUBLIC_API_STATIC=
# Base for relative MediaRef keys (media/…). Defaults: /sim for sim, /media for http.
PUBLIC_MEDIA_BASE=
